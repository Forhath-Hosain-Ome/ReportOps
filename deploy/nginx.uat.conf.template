log_format readiness_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    access_log /var/log/nginx/access.log readiness_safe;
    resolver 127.0.0.11 valid=2s ipv6=off;
    set $backend_upstream backend:8000;
    listen 80;
    server_name ${SERVER_NAMES};
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 500M;
    location ~ ^/(auth|image|puma|final-summary|top-five|mail-fetch|admin)/ {
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 18080;
        proxy_read_timeout 180s;
    }
    location /ws/ {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 18080;
        proxy_read_timeout 86400s;
        error_log /dev/null;
    }
    location /static/ {
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 18080;
    }
    location / { try_files $uri $uri/ /index.html; }
}
